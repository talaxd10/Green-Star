# Copy to .env. Node reads it by itself; nothing needs to be exported.

# Owner role: runs migrations. Never used by the running app.
DATABASE_URL=postgres://gs_owner:gs_owner@127.0.0.1:5432/green_star_dev
# App role: can add to the ledger, can never change or delete it.
APP_DATABASE_URL=postgres://gs_app:gs_app@127.0.0.1:5432/green_star_dev

# The tests wipe and rebuild this database on every run.
TEST_DATABASE_URL=postgres://gs_owner:gs_owner@127.0.0.1:5432/green_star_test
TEST_APP_DATABASE_URL=postgres://gs_app:gs_app@127.0.0.1:5432/green_star_test
